# Bu fayldan nusxa oling:  cp .env.example .env
# Keyin .env ni to'ldiring. .env fayli git'ga TUSHMAYDI (.gitignore da).

# @BotFather dan olgan token
# ⚠️ Eski token GitHub'da ochiq qolgan edi — @BotFather → /mybots → botni
# tanlang → API Token → "Revoke current token" bosib YANGI token oling.
BOT_TOKEN=123456789:AAH...

# Kinolar saqlanadigan baza kanal ID (manfiy son)
BAZA_KANAL_ID=-1001234567890

# Adminlar ID si (bir nechta bo'lsa vergul bilan: 111,222)
ADMIN_IDS=123456789

# ===== ixtiyoriy =====

# Baza fayli
DB_PATH=baza.db

# VIP status necha kun beriladi
VIP_KUNLAR=30

# VIP olish uchun nechta do'st taklif qilish kerak
REFERAL_KERAK=10

# Reklama tarqatish tezligi (sekundda xabar, 25 dan oshirmang)
TARQATISH_TEZLIGI=20
